			<div class="container">
		<h1>Manage Courses</h1>
		
		<form action="#" th:action="@{/courseForm}" th:object="${course}" method="POST" 
		class="form-horizontal coloring">
			<input type="hidden" name="id" value="${course.courseId}"/>
			<div class="form-group">
				<div class="col-md-12">
				<div class="col-md-5">
					<input type="text" placeholder="Course Title" id="courseTitle" class="form-control" name="courseTitle" th:field="*{courseTitle}"/>
					<span th:if="${#fields.hasErrors('courseTitle')}" th:errors="*{courseTitle}"></span>
				</div>
			</div>
			
			<div class="form-group">
				
				<div class="col-md-5">
					<input type="text" placeholder="Course Code" id="courseCode" class="form-control" name="courseCode" th:field="*{courseCode}"/>
					<span th:if="${#fields.hasErrors('courseCode')}" th:errors="*{courseCode}"></span>
				</div>
			</div>
			</div>
			<div class="form-group">
				<div class="col-md-5">
					<select name="semester">
						<option disabled="disabled">Select semester ...</option>
						<option value="first">First Semester</option>
						<option value="second">Second Semester</option>
					</select>
				</div>
			</div>
			<div class="form-group">
				
				<div class="col-md-5">
					<select name="level">
						<option disabled="disabled">Select Level ...</option>
						<option value="500">500 Level</option>
						<option value="600">600 Level</option>
						<option value="700">700 Level</option>
						<option value="800">800 Level</option>
						<option value="900">900 Level</option>
					</select>
					</div>
			</div>
			<div class="form-group">
				
				<div class="col-md-5">
					<select name="creditUnit">
						<option disabled="disabled">Select Credit Unit ...</option>
						<option value="0">0</option>
						<option value="1">2</option>
						<option value="2">3</option>
						<option value="3">4</option>
						<option value="4">5</option>
						<option value="5">6</option>
						<option value="6">7</option>
						<option value="7">8</option>
						<option value="8">9</option>
						<option value="10">10</option>
					</select>
					</div>
			</div>
			<div class="form-group">
				<div class="col-md-5">
					<input type="text" placeholder="Course Session" id="courseSession" class="form-control" name="courseSession" th:field="*{courseSession}"/>
					<span th:if="${#fields.hasErrors('courseSession')}" th:errors="*{courseSession}"></span>
				</div>
			</div>
			<div class="form-group">
				<div class="col-md-5">
					<select name="courseType">
						<option disabled="disabled">Select Course Type ...</option>
						<option value="PGD">PGD</option>
						<option value="MSc">MSc</option>
						<option value="PhD">PhD</option>
					</select>
				</div>
			</div>
			<div class="form-group">
				<div class="col-md-5">
					<select name="department">
						<option disabled="disabled">Select your department</option>
						<option th:each="unit : ${units}" 
							th:value="${unit.unitDept}" 
							th:text="${unit.unitDept}">	
						</option>
					</select>
				</div>
			</div>
			<div class="form-group">
				<input type="submit" class="btn btn-primary" value="Add Unit"/>
			</div>
		</form>
		</div>
			
	
