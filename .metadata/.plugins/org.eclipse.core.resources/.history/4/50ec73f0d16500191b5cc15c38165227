	<div class="container">
		<h2>Student's Result</h2>
		<div class="table-response" th:switch="${students}">
				<table class="table table-striped table-bordered text-left">
						<tr>
							<td>Surname</td>
							<td>First Name</td>
							<td>Middle Name</td>
							<td>Matric No.</td>
						</tr>
						<tr th:each="course : ${courses}">
							
							<td th:utext="${course.courseCode}">...</td>
						
						</tr>
					
						<tr th:each ="student : ${PGDstudents}">
			               <td th:utext="${student.surname}">...</td>
			               <td th:utext="${student.firstname}">...</td>
			               <td th:utext="${student.middlename}">...</td>
			               <td th:utext="${student.matricNo}">...</td>
			               
			               <td><a th:href="@{/edit/{id}(id=${student.studentId})}">Edit</a></td>
						   <td><a th:href="@{/delete/{id}(id=${student.studentId})}">Delete</a></td>
			            </tr>
						
				</table>
			</div>
	</div>
	
