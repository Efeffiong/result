			<div class="container">
		<h1>Manage Student</h1>
		
		<form action="#" th:action="@{/addstudent}" th:object="${student}" method="POST" 
		class="form-horizontal coloring">
			<input type="hidden" name="id" value="${student.studentId}"/>
			<div class="form-group">
				
				<div class="col-md-5">
					<input type="text" placeholder="Surname" id="surname" class="form-control" name="surname" th:field="*{surname}"/>
					<span th:if="${#fields.hasErrors('surname')}" th:errors="*{surname}"></span>
				</div>
			</div>
			
			<div class="form-group">
				
				<div class="col-md-5">
					<input type="text" placeholder="First Name" id="firstname" class="form-control" name="firstname" th:field="*{firstname}"/>
					<span th:if="${#fields.hasErrors('firstname')}" th:errors="*{firstname}"></span>
				</div>
			</div>
			
			<div class="form-group">
				
				<div class="col-md-5">
					<input type="text" placeholder="Middle Name" id="middlename" class="form-control" name="middlename" th:field="*{middlename}"/>
					<span th:if="${#fields.hasErrors('middlename')}" th:errors="*{middlename}"></span>
				</div>
			</div>
			
			<div class="form-group">
				
				<div class="col-md-5">
					<input type="text" placeholder="Matriculation Number" id="matricNo" class="form-control" name="matricNo" th:field="*{matricNo}"/>
					<span th:if="${#fields.hasErrors('matricNo')}" th:errors="*{matricNo}"></span>
				</div>
			</div>
			
			<div class="form-group">
				
				<div class="col-md-5">
					<label>Male</label>
					<input type="radio" placeholder="Sex" id="sex" value="male" class="form-control" name="sex" th:field="*{sex}"/>
					<label>Femal</label>
					<input type="radio" placeholder="Sex" id="sex" value="female" class="form-control" name="sex" th:field="*{sex}"/>
					<span th:if="${#fields.hasErrors('sex')}" th:errors="*{sex}"></span>
				</div>
			</div>
			
			<div class="form-group">
				
				<div class="col-md-5" >
					<input type="text" placeholder="Session" id="session" class="form-control" name="session" th:field="*{session}"/>
					<span th:if="${#fields.hasErrors('session')}" th:errors="*{session}"></span>
				</div>
			</div>
			
			<div class="form-group">
				<input type="submit" class="btn btn-primary" value="Add Student"/>
			</div>
		</form>
